# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional default Groq API key for Whisper speech recognition.
# Additional Groq and Gemini rotation keys can be managed in the API Key Manager.
GROQ_API_KEY=""

# KEY_ENCRYPTION_SECRET: Optional 32-byte hex/passphrase for encrypting local API keys at rest.
KEY_ENCRYPTION_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
